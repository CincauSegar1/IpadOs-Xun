# Kernel configuration of the Xiaomi Redmi Pad SE 11" (xun, SM6225):
# generic CPU, interrupt, timer and platform expert path, source corecrypto and pthread providers,
# SoftwareAES, 4 KiB code-signing hash cache, and NativeEmmc root storage on sdhci@4744000.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y

# NativeEmmc: Qualcomm SDHCI MSM (sdhci@4744000) eMMC 5.1.
# CONFIG_XNU_NATIVE_UFS is the framework's storage-linkage switch (the name is historical: it
# gates the XNU_NATIVE_* block-storage linkage that NativeEmmc also uses). The driver that actually
# attaches on this board is CONFIG_XNU_NATIVE_EMMC; libXunEmmc.a is copied to
# build/sheng-ufs/libShengUfs.a because that is the path the framework links.
CONFIG_XNU_NATIVE_UFS=y
# Source storage: IOBlockStorageDevice is compiled from the pinned public IOStorageFamily sources
# and registered below the running family at start-up, instead of binding the six base-class symbols
# to addresses read out of the kernelcache. 24B156 has no symbol table to read them from. Set by
# build-xun-source-storage.py, which is the archive builder named in board.toml.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_NATIVE_EMMC=y
CONFIG_XNU_NATIVE_EMMC_ARCHIVE="{tree}/build/sheng-ufs/libShengUfs.a"

# Writable sparse RAM Data seed + verified root/owner policy + BootProgress telemetry:
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
# Source storage ignores this switch: build-xnu-4k-baseline.sh only consults it when
# XNU_SOURCE_STORAGE=0, and package/SourceStorage.cpp starts the seed disk from /dev/md0 through
# the owner-data patch's #else arm. Left on so the intent is recorded and a future return to the
# alias path does not silently lose the RAM block.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-key/libVerifiedRootKey.a"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y

# The SystemOS volume of the signed policy and the Data seed volume of the payload.
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="04769D26-2CA0-4825-B443-E2E5F88300F2"
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="73F1FA24-4189-446D-96D4-FB6324EBE955"
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# SM6225 Kryo 265 cores (Cortex-A73 Gold, Cortex-A53 Silver) are ARMv8.0 and lack PAN.
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_SHENG_PMGR=y
# The four Cortex-A73 cores report MPIDR 0x100..0x103, i.e. above 0xFF, so osfmk/arm64/start.s
# must mask 0xFFFF rather than 0xFF when it turns MPIDR into a CPU number. Without this the
# patch's #if names an undefined macro, so the switch has to exist even though it is only ever
# consumed by that one expression.
CONFIG_XNU_QCOM_CLUSTERED_MPIDR=y

# On-screen bring-up progress bars + fault/process telemetry
CONFIG_XNU_BOOT_PROGRESS=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_BUILD_ARCHIVES=y

CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_NATIVE_ADRENO=n
