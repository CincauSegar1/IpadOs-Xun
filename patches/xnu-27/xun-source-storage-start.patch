diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb558ee..1811d8a 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -694,6 +694,23 @@ bsd_init(void)
 	bsd_init_kprintf("calling IOKitInitializeTime\n");
 	IOKitInitializeTime();
 
+	/*
+	 * xun: NativeEmmc and NativeRamBlock are built into this kernel, and their class
+	 * registration lives in this call. The builders strip __mod_init_func from those
+	 * objects and export __GLOBAL__sub_I_* instead, so SourceStorage.o's
+	 * native_source_storage_start() is what constructs the OSMetaClass instances.
+	 * Without it IOKit matches the personality but not the class, nothing publishes
+	 * the volumes, and the OS window has nothing to mount.
+	 *
+	 * Strong reference on purpose: the archive is always linked for this board, and
+	 * an arm64e weak import becomes a chained bind that the payload patch path
+	 * rejects.
+	 */
+	{
+		extern void native_source_storage_start(void);
+		native_source_storage_start();
+	}
+
 	/* Initialize the file systems. */
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
