diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index d4909c7..c44e3b9 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -143,7 +143,11 @@ LEXT(reset_vector)
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER
+#if HAS_CLUSTER || XNU_QCOM_CLUSTERED_MPIDR
+	// SM6225 numbers its four Cortex-A53 cores 0x0..0x3 and its four Cortex-A73 cores
+	// 0x100..0x103 in MPIDR_EL1 Affinity1. The A73 cores are therefore above 0xFF and the
+	// 0xFF mask below names them wrong: cores 0x100..0x103 all collapse onto CPU numbers the
+	// A53s already hold, so the secondary start never selects a distinct entry for them.
 	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
